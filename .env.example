# ============ 伺服器設定 ============
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============ 資料庫設定 (MySQL) ============
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sailo

# ============ JWT 設定 ============
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============ Session 設定 ============
SESSION_SECRET=

# ============ 登入安全設定 ============
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# ============ Email 設定 (寄送驗證信、通知等) ============
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=

# ============ Google OAuth 2.0 ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v2/auth/google/callback

# ============ ImageKit 圖片雲端儲存 ============
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
